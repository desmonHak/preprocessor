// Ejemplo 08: Metaprogramacion avanzada
// Generacion de tablas y rutinas repetitivas con #repeat y #foreach.

#array OPCODES (nop, mov, add, sub, mul, div, cmp, jmp, call, ret)
#array REGS    (r0, r1, r2, r3, r4, r5, r6, r7)

// numero de instrucciones como constante
#define NUM_OPCODES  __ARRAY_SIZE__(OPCODES)
#define NUM_REGS     __ARRAY_SIZE__(REGS)

// polinomio CRC simplificado
#define CRC_POLY 0x07

@Format("velb")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
}

code:
    @InitPc(code)

    // cargar numero de opcodes calculado en preprocesado
    mov r0, NUM_OPCODES     // r0 = 10
    mov r1, NUM_REGS        // r1 = 8

    hlt
end_code:

align 16
data:
    // tabla de potencias de 2: 2^0 .. 2^7 (valores calculados por __POW__ en preprocesado)
    pow2_table dq __POW__(2, 0), __POW__(2, 1), __POW__(2, 2), __POW__(2, 3), __POW__(2, 4), __POW__(2, 5), __POW__(2, 6), __POW__(2, 7)

    // tabla CRC: i XOR CRC_POLY para i=0..7 (calculado manualmente)
    crc_table db 7, 6, 5, 4, 3, 2, 1, 0

    // nombres de opcodes como cadenas (acceso por indice via __ARRAY_GET__)
    opcode_0 db __TOUPPER__(__ARRAY_GET__(OPCODES, 0)), 0x00
    opcode_1 db __TOUPPER__(__ARRAY_GET__(OPCODES, 1)), 0x00
    opcode_2 db __TOUPPER__(__ARRAY_GET__(OPCODES, 2)), 0x00
    opcode_3 db __TOUPPER__(__ARRAY_GET__(OPCODES, 3)), 0x00
    opcode_4 db __TOUPPER__(__ARRAY_GET__(OPCODES, 4)), 0x00

    num_opcodes dw NUM_OPCODES
    num_regs    dw NUM_REGS

    // tabla de cuadrados: 0^2 .. 7^2 (calculado por __POW__ en preprocesado)
    squares dw __POW__(0, 2), __POW__(1, 2), __POW__(2, 2), __POW__(3, 2), __POW__(4, 2), __POW__(5, 2), __POW__(6, 2), __POW__(7, 2)
end_data:
