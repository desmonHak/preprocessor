// Ejemplo 15: #macro ... #endmacro
// #macro NAME(params) ... #endmacro define una macro multilinea que genera
// bloques de instrucciones al ser invocada. A diferencia de #define (una linea),
// #macro puede expandirse a multiples instrucciones, reduciendo la repeticion
// de patrones de llamada boilerplate.
//
// Casos de uso tipicos:
//   - Wrappers para funciones nativas con convencion de llamada fija
//   - Secuencias de inicializacion repetitivas
//   - Generacion de codigo parametrizado

// macro: imprime un entero (vio_print_int: r1=valor, r15=1)
#macro PRINT_INT(val)
    mov r1, val
    mov r15, 1
    calln @Method("stdlib/native/io/vesta_io:vio_print_int")
#endmacro

// macro: imprime una cadena con longitud conocida (vio_println: r1=proc, r2=addr, r3=len, r15=3)
#macro PRINTLN(proc, addr, len)
    mov r1, proc
    mov r2, addr
    mov r3, len
    mov r15, 3
    calln @Method("stdlib/native/io/vesta_io:vio_println")
#endmacro

// macro: carga dos valores y opera (demostracion de macro aritmetica)
#macro LOAD_PAIR(dst_a, dst_b, val_a, val_b)
    mov dst_a, val_a
    mov dst_b, val_b
#endmacro

// macro para calcular suma de dos constantes en tiempo de preprocesado
// e imprimirla en runtime
#macro PRINT_SUM(a, b)
    mov r1, __ADD__(a, b)
    mov r15, 1
    calln @Method("stdlib/native/io/vesta_io:vio_print_int")
#endmacro

@Format("velb")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
}

@Import {
    @Method { @Lib("stdlib/native/io/vesta_io") @Name("vio_print_int") }
    @Method { @Lib("stdlib/native/io/vesta_io") @Name("vio_println") }
}

code:
    @InitPc(code)

    getproc r14

    // cada invocacion expande a: mov r1, N; mov r15, 1; calln vio_print_int
    PRINT_INT(42)
    PRINT_INT(100)
    PRINT_INT(__MUL__(6, 7))        // argumento calculado en preprocesado -> 42
    PRINT_INT(__ADD__(1000, 337))   // -> 1337

    // macro PRINTLN: imprime la cadena "hello"
    PRINTLN(r14, @Absolute("all.hello"), 5)

    // macro LOAD_PAIR: carga dos registros en una sola invocacion
    LOAD_PAIR(r0, r1, 10, 20)   // mov r0, 10; mov r1, 20
    LOAD_PAIR(r2, r3, __POW__(2, 8), __POW__(2, 16))   // r2=256, r3=65536

    // macro PRINT_SUM: suma en preprocesado, imprime en runtime
    PRINT_SUM(300, 37)    // imprime 337
    PRINT_SUM(__POW__(2, 4), __POW__(2, 3))  // imprime 24 (16 + 8)

    hlt
end_code:

align 16
data:
    hello    db "hello", 0x00
    answer   dw 42
    large    dw __MUL__(6, 7)   // 42
end_data:
