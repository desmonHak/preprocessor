// vesta/platform.vph — deteccion de plataforma y constantes dependientes del SO
// Uso: #import <vesta/platform>
#pragma once

// --- deteccion de sistema operativo -----------------------------------------
#ifdef __VPP_WINDOWS__
    #define OS_NAME         "Windows"
    #define PATH_SEP        "\\"
    #define PATH_SEP_CHAR   92       // '\'
    #define DLL_EXT         ".dll"
    #define EXE_EXT         ".exe"
    #define LINE_END        "\r\n"
    #define LINE_END_LEN    2
    #define OS_WINDOWS      1
    #define OS_LINUX        0
    #define OS_MACOS        0
#elif defined(__VPP_LINUX__)
    #define OS_NAME         "Linux"
    #define PATH_SEP        "/"
    #define PATH_SEP_CHAR   47       // '/'
    #define DLL_EXT         ".so"
    #define EXE_EXT         ""
    #define LINE_END        "\n"
    #define LINE_END_LEN    1
    #define OS_WINDOWS      0
    #define OS_LINUX        1
    #define OS_MACOS        0
#elif defined(__VPP_MACOS__)
    #define OS_NAME         "macOS"
    #define PATH_SEP        "/"
    #define PATH_SEP_CHAR   47
    #define DLL_EXT         ".dylib"
    #define EXE_EXT         ""
    #define LINE_END        "\n"
    #define LINE_END_LEN    1
    #define OS_WINDOWS      0
    #define OS_LINUX        0
    #define OS_MACOS        1
#else
    #define OS_NAME         "Unknown"
    #define PATH_SEP        "/"
    #define PATH_SEP_CHAR   47
    #define DLL_EXT         ".so"
    #define EXE_EXT         ""
    #define LINE_END        "\n"
    #define LINE_END_LEN    1
    #define OS_WINDOWS      0
    #define OS_LINUX        0
    #define OS_MACOS        0
#endif

// --- deteccion de arquitectura -----------------------------------------------
#ifdef __VPP_X86_64__
    #define ARCH_NAME       "x86-64"
    #define ARCH_BITS       64
    #define ARCH_X86_64     1
    #define ARCH_X86_32     0
    #define ARCH_ARM64      0
#elif defined(__VPP_X86_32__)
    #define ARCH_NAME       "x86-32"
    #define ARCH_BITS       32
    #define ARCH_X86_64     0
    #define ARCH_X86_32     1
    #define ARCH_ARM64      0
#elif defined(__VPP_AARCH64__)
    #define ARCH_NAME       "AArch64"
    #define ARCH_BITS       64
    #define ARCH_X86_64     0
    #define ARCH_X86_32     0
    #define ARCH_ARM64      1
#else
    #define ARCH_NAME       "Unknown"
    #define ARCH_BITS       64
    #define ARCH_X86_64     0
    #define ARCH_X86_32     0
    #define ARCH_ARM64      0
#endif
