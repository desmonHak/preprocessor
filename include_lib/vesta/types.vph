// vesta/types.vph — tamanios de tipos y constantes de rango entero
// Uso: #import <vesta/types>
#pragma once

// tamanios en bytes de los tipos de datos basicos
#define SIZEOF_BYTE     1
#define SIZEOF_WORD     2
#define SIZEOF_DWORD    4
#define SIZEOF_QWORD    8
#define SIZEOF_PTR      8   // arquitectura de 64 bits

// tamanios en bits
#define BITS_BYTE       8
#define BITS_WORD       16
#define BITS_DWORD      32
#define BITS_QWORD      64

// limites de enteros sin signo
#define UINT8_MAX       255
#define UINT16_MAX      65535
#define UINT32_MAX      4294967295
#define UINT64_MAX      18446744073709551615

// limites de enteros con signo (complemento a dos)
#define INT8_MIN        -128
#define INT8_MAX        127
#define INT16_MIN       -32768
#define INT16_MAX       32767
#define INT32_MIN       -2147483648
#define INT32_MAX       2147483647
#define INT64_MIN       -9223372036854775808
#define INT64_MAX       9223372036854775807

// mascaras de bits comunes
#define MASK8           0xFF
#define MASK16          0xFFFF
#define MASK32          0xFFFFFFFF
#define MASK64          0xFFFFFFFFFFFFFFFF

// constante nula / cero tipado
#define NULL_PTR        0
#define NULLPTR         0
